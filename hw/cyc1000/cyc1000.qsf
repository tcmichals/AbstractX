# Intel Quartus Settings File for Trenz CYC1000 (10CL025YU256C8G)
# AbstractX Architecture Target Configuration

set_global_assignment -name FAMILY "Cyclone 10 LP"
set_global_assignment -name DEVICE 10CL025YU256C8G
set_global_assignment -name TOP_LEVEL_ENTITY top_cyc1000
set_global_assignment -name PROJECT_OUTPUT_DIRECTORY build

# System Clock & Reset
set_location_assignment PIN_M2 -to i_clk
set_instance_assignment -name IO_STANDARD "3.3-V LVCMOS" -to i_clk
set_location_assignment PIN_N6 -to i_reset_n
set_instance_assignment -name IO_STANDARD "3.3-V LVCMOS" -to i_reset_n

# Host SPI Interface (MKR Header)
set_location_assignment PIN_M1 -to i_spi_sclk
set_location_assignment PIN_P1 -to i_spi_cs_n
set_location_assignment PIN_N2 -to io_spi_io0
set_location_assignment PIN_N1 -to io_spi_io1
set_location_assignment PIN_L2 -to o_int_req

# IMU SPI Master (ICM-42688-P)
set_location_assignment PIN_B1 -to o_imu_sclk
set_location_assignment PIN_C2 -to o_imu_cs_n
set_location_assignment PIN_J1 -to o_imu_mosi
set_location_assignment PIN_J2 -to i_imu_miso
set_location_assignment PIN_K1 -to i_imu_int

# Actuators
set_location_assignment PIN_K2 -to o_motor_pins[0]
set_location_assignment PIN_L1 -to o_motor_pins[1]
set_location_assignment PIN_P2 -to o_motor_pins[2]
set_location_assignment PIN_R1 -to o_motor_pins[3]
set_location_assignment PIN_T1 -to o_neopixel_pin

# User LEDs
set_location_assignment PIN_M6 -to o_led[0]
set_location_assignment PIN_T4 -to o_led[1]
set_location_assignment PIN_T3 -to o_led[2]
set_location_assignment PIN_R3 -to o_led[3]
set_location_assignment PIN_T2 -to o_led[4]
set_location_assignment PIN_R4 -to o_led[5]
set_location_assignment PIN_N5 -to o_led[6]
set_location_assignment PIN_N3 -to o_led[7]
