{
  "application": "inav_e906_app",
  "version": "1.0.0",
  "target": "XuanTie E906 (Allwinner T527 / Radxa Cubie A5E)",
  "wire_protocol": {
    "magic": "0xC1FC1FC1",
    "frame_size_bytes": 64,
    "header_size_bytes": 20,
    "payload_size_bytes": 40,
    "crc_size_bytes": 4
  },
  "streams": {
    "1": {
      "name": "inav_flight_io",
      "channel": 0,
      "description": "Real-time bare-metal sensor streams from XuanTie E906 I/O Processor",
      "events": {
        "1": {
          "name": "imu_raw_burst",
          "rate_hz": 1000,
          "source_device": "ICM-42688-P (SPI1 @ 10 MHz)",
          "bar_address": "0x40001000",
          "tag": 1,
          "unpack_format": ">3h3hh",
          "fields": [
            { "name": "accel_x_raw", "type": "int16", "unit": "LSB", "scale": 0.00048828125, "display_name": "Accel X (g)", "widget": "oscilloscope" },
            { "name": "accel_y_raw", "type": "int16", "unit": "LSB", "scale": 0.00048828125, "display_name": "Accel Y (g)", "widget": "oscilloscope" },
            { "name": "accel_z_raw", "type": "int16", "unit": "LSB", "scale": 0.00048828125, "display_name": "Accel Z (g)", "widget": "oscilloscope" },
            { "name": "gyro_x_raw", "type": "int16", "unit": "LSB", "scale": 0.06103515625, "display_name": "Gyro X (deg/s)", "widget": "oscilloscope" },
            { "name": "gyro_y_raw", "type": "int16", "unit": "LSB", "scale": 0.06103515625, "display_name": "Gyro Y (deg/s)", "widget": "oscilloscope" },
            { "name": "gyro_z_raw", "type": "int16", "unit": "LSB", "scale": 0.06103515625, "display_name": "Gyro Z (deg/s)", "widget": "oscilloscope" },
            { "name": "temp_raw", "type": "int16", "unit": "degC", "scale": 0.00306, "offset": 25.0, "display_name": "IMU Temperature", "widget": "gauge" }
          ]
        },
        "2": {
          "name": "gps_fix",
          "rate_hz": 10,
          "source_device": "u-blox NEO-M8N (UART3 @ 115200 baud)",
          "bar_address": "0x40005000",
          "tag": 2,
          "unpack_format": "<i5i2B",
          "fields": [
            { "name": "itow_ms", "type": "int32", "unit": "ms", "scale": 1.0, "display_name": "GPS Time of Week" },
            { "name": "lat_1e7", "type": "int32", "unit": "deg", "scale": 1e-7, "display_name": "Latitude", "widget": "map" },
            { "name": "lon_1e7", "type": "int32", "unit": "deg", "scale": 1e-7, "display_name": "Longitude", "widget": "map" },
            { "name": "alt_mm", "type": "int32", "unit": "m", "scale": 0.001, "display_name": "GPS Altitude", "widget": "altimeter" },
            { "name": "ground_speed_mm_s", "type": "int32", "unit": "m/s", "scale": 0.001, "display_name": "Ground Speed", "widget": "airspeed" },
            { "name": "heading_1e5", "type": "int32", "unit": "deg", "scale": 1e-5, "display_name": "Course Heading", "widget": "compass" },
            { "name": "sats", "type": "uint8", "unit": "", "scale": 1.0, "display_name": "Satellites Tracked" },
            { "name": "fix_type", "type": "uint8", "unit": "", "scale": 1.0, "display_name": "Fix Type" }
          ]
        },
        "3": {
          "name": "mag_sample",
          "rate_hz": 100,
          "source_device": "HMC5883L / QMC5883L (TWI1 @ 400 kHz)",
          "bar_address": "0x40003000",
          "tag": 3,
          "unpack_format": "<3h2B",
          "fields": [
            { "name": "mag_x", "type": "int16", "unit": "mG", "scale": 1.0, "display_name": "Mag X" },
            { "name": "mag_y", "type": "int16", "unit": "mG", "scale": 1.0, "display_name": "Mag Y" },
            { "name": "mag_z", "type": "int16", "unit": "mG", "scale": 1.0, "display_name": "Mag Z" },
            { "name": "chip_type", "type": "uint8", "unit": "", "scale": 1.0, "display_name": "Chip (1=HMC, 2=QMC)" },
            { "name": "pad", "type": "uint8", "unit": "", "scale": 1.0, "display_name": "Reserved" }
          ]
        },
        "4": {
          "name": "fpga_frame",
          "rate_hz": 1000,
          "source_device": "Companion FPGA (SPI1 Dual-I/O Mode)",
          "bar_address": "0x40004000",
          "tag": 4,
          "unpack_format": "40s",
          "fields": [
            { "name": "payload", "type": "bytes", "unit": "", "scale": 1.0, "display_name": "FPGA Fast I/O Frame" }
          ]
        }
      }
    }
  }
}
