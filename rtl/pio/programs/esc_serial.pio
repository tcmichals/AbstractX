;
; Half-duplex 8N1 UART on one motor wire, for the ESC 4-way passthrough ([SPEC-PIO-13]).
;
; Clock: 32 SM cycles per bit; the host sets the divider (19200 baud: 614.4 kHz).
; Pins: OUT, SET, IN base and JMP_PIN = the motor pin. Shift right (LSB first), no autopush/pull.
; TX FIFO: one byte per word (bits [7:0]). Bytes are sent back to back while the FIFO has
;          data; then the line is held high one more bit (guard) and released.
; RX FIFO: one received byte per word, in bits [31:24]. Nothing is received while sending.
; Break:   the host drives the line low with SMx_INSTR (set pindirs, 1 / set pins, 0) while
;          this state machine is disabled; the program never does.

.program esc_serial
.wrap_target
rx_idle:
    jmp pin check_tx            ; line high: anything to send?
    jmp rx_start                ; line low: start bit
check_tx:
    mov x, ~null
    pull noblock                ; empty FIFO -> OSR = X = all ones (no byte looks like that)
    mov y, osr
    jmp x!=y tx_start
    jmp rx_idle
rx_start:
    nop                  [14]
    jmp pin rx_idle             ; high at the middle of the start bit: glitch
    set x, 7             [29]
rx_bit:
    in pins, 1           [30]   ; middle of each data bit
    jmp x-- rx_bit
    push block
    jmp rx_idle
tx_start:
    set pins, 1
    set pindirs, 1
tx_byte:
    set pins, 0          [30]   ; start bit
    set x, 7
tx_bit:
    out pins, 1          [30]
    jmp x-- tx_bit
    set pins, 1          [31]   ; stop bit
    mov x, ~null
    pull noblock
    mov y, osr
    jmp x!=y tx_byte            ; next byte back to back
    nop                  [31]   ; guard: one more bit high
    set pindirs, 0              ; release; the ESC may answer now
.wrap
