;
; RP2040 ISA conformance programs ([SPEC-PIO-02]); each one makes a known
; deviation visible. Used by sim/cocotb/test_asp_pio_conformance_cocotb.py.

; Rule 1: blocking pull stalls on an empty TX FIFO.
.program c_pull_block
    pull block
    set pins, 1
    out x, 32
    in x, 32
    push block
    set pins, 0

; Rule 2: pull noblock on an empty FIFO copies X into OSR.
.program c_pull_noblock
    set x, 21
    pull noblock
    mov isr, osr
    push block
hang:
    jmp hang

; Rule 2: push noblock on a full RX FIFO is dropped and does not stall.
.program c_push_noblock
    set x, 4
loop:
    mov isr, x
    push noblock
    jmp x-- loop
    set pins, 1
hang:
    jmp hang

; Rule 3: autopush pushes the ISR after the shift (thresh 8, shift left).
.program c_autopush
    set x, 5
    in x, 4
    set x, 10
    in x, 4
hang:
    jmp hang

; Rule 1/3: autopush on a full RX FIFO stalls without losing or repeating a word (thresh 32).
.program c_autopush_full
    set x, 31
loop:
    in x, 32
    jmp x-- loop
hang:
    jmp hang

; Rule 3: autopull refills OSR and an OUT on an empty OSR + empty FIFO stalls (thresh 32, shift right).
.program c_autopull
.wrap_target
    out x, 8
    mov isr, x
    push block
.wrap

; Rule 4: mov osr resets the OSR count (full), so !OSRE is true.
.program c_mov_osr
    set x, 7
    mov osr, x
    jmp !osre full
    set y, 0
    jmp report
full:
    set y, 1
report:
    mov isr, y
    push block
hang:
    jmp hang

; Rule 4: mov isr clears the ISR count (autopush thresh 8).
.program c_mov_isr
    set x, 3
    in x, 4
    mov isr, null
    in x, 4
    in x, 4
hang:
    jmp hang

; Rule 4: mov x, status is all-ones when the TX level is below STATUS_N.
.program c_mov_status
    mov isr, status
    push block
hang:
    jmp hang

; Rule 5: .side_set 1 opt (SIDESET_COUNT 2 includes the enable bit).
.program c_sideset_opt
.side_set 1 opt
    set x, 1 side 1
    set x, 2
    set x, 3
    jmp done side 0
done:
    jmp done

; Rule 6: irq wait waits until the flag is cleared.
.program c_irq_wait
    irq wait 0
    set pins, 1
hang:
    jmp hang

; Rule 6: irq rel keeps bit 2: index 4 rel on SM1 is flag 5.
.program c_irq_rel
    irq set 4 rel
hang:
    jmp hang

; Rule 1: wait gpio stalls until the pin matches.
.program c_wait_gpio
    wait 1 gpio 7
    set pins, 1
hang:
    jmp hang

; Rule 7: restart releases pin ownership.
.program c_drive
    set pindirs, 1
    set pins, 1
hang:
    jmp hang
