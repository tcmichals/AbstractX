        },
        {
            "name": "Pico 2 W: SWD Debug (GDB / OpenOCD pipe)",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build_pico2w/apps/gps_imu_app/gps_imu_app.elf",
            "args": [],
            "stopAtEntry": true,
            "cwd": "${workspaceFolder}",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "miDebuggerPath": "/home/tcmichals/.tools/xpack-arm-none-eabi-gcc-15.2.1-1.1/bin/arm-none-eabi-gdb",
            "miDebuggerServerAddress": "localhost:3333",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                },
                {
                    "description": "Reset and halt target",
                    "text": "monitor reset init",
                    "ignoreFailures": false
                }
            ],
            "preLaunchTask": "Start OpenOCD (RP2350)"
