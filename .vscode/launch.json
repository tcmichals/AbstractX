{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Pico 2 W: SWD Debug (Cortex-Debug)",
            "type": "cortex-debug",
            "request": "launch",
            "servertype": "openocd",
            "cwd": "${workspaceFolder}",
            "executable": "${workspaceFolder}/build_pico2w_debug/apps/gps_imu_app/gps_imu_app.elf",
            "serverpath": "/home/tcmichals/.tools/oss-cad-suite/bin/openocd",
