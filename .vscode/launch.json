{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Pico 2 W: SWD Debug (Cortex-Debug)",
            "type": "cortex-debug",
            "request": "launch",
            "servertype": "openocd",
            "cwd": "${workspaceFolder}",
            "executable": "${workspaceFolder}/build_pico2w/apps/pico2w_companion/pico2w_companion.elf",
            "serverpath": "/home/tcmichals/.tools/openocd/bin/openocd",
            "armToolchainPath": "/home/tcmichals/.tools/gcc-arm-none-eabi/bin",
            "gdbPath": "/home/tcmichals/.tools/gcc-arm-none-eabi/bin/arm-none-eabi-gdb",
            "searchDir": [
                "/home/tcmichals/.tools/openocd/openocd/scripts"
            ],
            "configFiles": [
                "interface/cmsis-dap.cfg",
                "target/rp2350.cfg"
            ],
            "openOCDPreConfigLaunchCommands": [
                "adapter speed 5000"
            ],
            "runToEntryPoint": "main",
            "svdFile": "",
            "preLaunchTask": "Build Pico 2 W Firmware"
        },
        {
            "name": "Pico 2 W: SWD Debug (GDB / OpenOCD pipe)",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build_pico2w/apps/pico2w_companion/pico2w_companion.elf",
            "args": [],
            "stopAtEntry": true,
            "cwd": "${workspaceFolder}",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "miDebuggerPath": "/home/tcmichals/.tools/gcc-arm-none-eabi/bin/arm-none-eabi-gdb",
            "miDebuggerServerAddress": "localhost:3333",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                },
                {
                    "description": "Reset and halt target",
                    "text": "monitor reset init",
                    "ignoreFailures": false
                }
            ],
            "preLaunchTask": "Start OpenOCD (RP2350)"
        },
        {
            "name": "ESP32-P4: JTAG Debug (GDB / OpenOCD)",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build_esp32p4/apps/esp32p4_hub/esp32p4_hub.elf",
            "args": [],
            "stopAtEntry": true,
            "cwd": "${workspaceFolder}",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "miDebuggerPath": "/home/tcmichals/.tools/xpack-riscv-none-elf-gcc-15.2.0-1/bin/riscv-none-elf-gdb",
            "miDebuggerServerAddress": "localhost:3333",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                },
                {
                    "description": "Reset and halt target",
                    "text": "monitor reset halt",
                    "ignoreFailures": false
                }
            ],
            "preLaunchTask": "Start OpenOCD (ESP32-P4)"
        },
        {
            "name": "Host: Flight Telemetry Node (SITL)",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build_host/examples/gps_imu_flight_node",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ],
            "preLaunchTask": "Build Host SITL & Tests"
        }
    ]
}
