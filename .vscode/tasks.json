{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build Pico 2 W Firmware",
            "type": "shell",
            "command": "export PICO_SDK_PATH=/home/tcmichals/.tools/pico/pico-sdk && cmake --build build_pico2w -j$(nproc)",
            "group": {
                "kind": "build",
                "isDefault": false
            },
            "problemMatcher": ["$gcc"]
        },
        {
            "label": "Build Pico 2 W Firmware (Debug)",
            "type": "shell",
            "command": "export PICO_SDK_PATH=/home/tcmichals/.tools/pico/pico-sdk && cmake -B build_pico2w -DCMAKE_BUILD_TYPE=Debug -DABSTRACTX_TARGET=pico2w -DPICO_PLATFORM=rp2350-arm-s -DPICO_BOARD=pico2_w -DCMAKE_TOOLCHAIN_FILE=cmake/toolchains/arm-none-eabi.cmake && cmake --build build_pico2w -j$(nproc)",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": ["$gcc"]
        },
        {
            "label": "Build Host SITL & Tests",
            "type": "shell",
            "command": "cmake --build build_host -j$(nproc)",
            "group": {
                "kind": "build",
                "isDefault": false
            },
            "problemMatcher": ["$gcc"]
        },
        {
            "label": "Build XuanTie E907 Firmware",
            "type": "shell",
            "command": "cmake --build build_e907 -j$(nproc)",
            "group": {
                "kind": "build",
                "isDefault": false
            },
            "problemMatcher": ["$gcc"]
        },
        {
            "label": "Start OpenOCD (RP2350)",
            "type": "shell",
            "command": "/home/tcmichals/.tools/oss-cad-suite/bin/openocd -s /home/tcmichals/.tools/oss-cad-suite/share/openocd/scripts -f interface/cmsis-dap.cfg -f target/rp2350.cfg -c 'adapter speed 5000'",
            "isBackground": true,
            "problemMatcher": {
                "pattern": {
                    "regexp": "^$"
                },
                "background": {
                    "activeOnStart": true,
                    "beginsPattern": "Open On-Chip Debugger",
                    "endsPattern": "Listening on port 3333 for gdb connections"
                }
            }
        },
        {
            "label": "Flash Pico 2 W via OpenOCD SWD",
            "type": "shell",
            "command": "/home/tcmichals/.tools/oss-cad-suite/bin/openocd -s /home/tcmichals/.tools/oss-cad-suite/share/openocd/scripts -f interface/cmsis-dap.cfg -f target/rp2350.cfg -c 'adapter speed 5000' -c 'program build_pico2w/apps/gps_imu_app/gps_imu_app.elf verify reset exit'",
            "dependsOn": "Build Pico 2 W Firmware",
            "problemMatcher": ["$gcc"]
        },
        {
            "label": "Run AbstractX Studio GUI",
            "type": "shell",
            "command": "python3 tools/visualizer/abstractx_studio.py --port 9870",
            "isBackground": true,
            "problemMatcher": []
        },
        {
            "label": "Run Flight Display GUI",
            "type": "shell",
            "command": "python3 apps/gps_imu_app/tools/flight_display.py --port 9870",
            "isBackground": true,
            "problemMatcher": []
        },
        {
            "label": "Audit Spec Coverage",
            "type": "shell",
            "command": "python3 tools/audit_specs.py",
            "group": "test",
            "problemMatcher": []
        }
    ]
}
